// Version and icon resources. Keep this file ASCII: rc.exe reads it with the build machine's code page.
#include <winresrc.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,1,0
 PRODUCTVERSION 0,2,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jisu Browser"
            VALUE "FileDescription", "Jisu Browser"
            VALUE "FileVersion", "0.2.1"
            VALUE "InternalName", "jisu-browser"
            VALUE "OriginalFilename", "jisu-browser.exe"
            VALUE "ProductName", "Jisu Browser"
            VALUE "ProductVersion", "0.2.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
